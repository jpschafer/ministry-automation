<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh fills in __CHECK__ and __LOG__. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jpschafer.sexton.fb-token</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__CHECK__</string>
  </array>
  <!-- Daily at 9:00; a run missed while asleep happens on wake. Also at login. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
